{
  "name": "fishtank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "birthday:qr": "bun tools/gen-birthday-qr.ts",
    "birthday:atlas": "bun run birthday:qr && bun tools/gen-birthday-atlas.ts",
    "test:birthday": "playwright test",
    "dev": "bun index.html",
    "build": "bun build index.html --outdir dist --minify",
    "serve": "bun run build && bun serve.ts",
    "compile": "bun build desktop.ts desktopServer.ts --compile --outfile fishtank",
    "caustics:generate": "bun tools/gen-caustics.ts",
    "preview:caustics": "bun tools/preview.ts MODE=caustics",
    "atlas:odyssey": "bun tools/gen-odyssey-fish-atlas.ts && bun tools/gen-odyssey-props-atlas.ts",
    "atlas:giger": "bun tools/gen-giger-fish-atlas.ts && bun tools/gen-giger-props-atlas.ts",
    "atlas:grindelwald": "bun tools/gen-grindelwald-props-atlas.ts",
    "atlas:regenerate": "bun tools/regenerate-atlas.ts",
    "preview:ruins-kit": "bun tools/preview.ts MODE=ruins-kit",
    "validate:ruins-kit": "bun tools/preview.ts MODE=ruins-kit VALIDATE_ONLY=1"
  },
  "dependencies": {
    "kaplay": "latest"
  },
  "optionalDependencies": {
    "webview-bun": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "bun-types": "latest",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "trustedDependencies": ["webview-bun"]
}
